reset.TextSize = 14
reset.Parent = main
Instance.new("UICorner",reset).CornerRadius = UDim.new(0,7)

roll.MouseButton1Click:Connect(function()
    local available = {}

    for name,color in pairs(colors) do
        if enabled[name] then
            table.insert(available,color)
        end
    end

    if #available == 0 then return end

    for i=1,4 do
        boxes[i].BackgroundColor3 =
            available[math.random(1,#available)]
    end
end)

reset.MouseButton1Click:Connect(function()
    for _,box in ipairs(boxes) do
        box.BackgroundColor3 = Color3.fromRGB(45,45,50)
    end

    for name in pairs(colors) do
        enabled[name] = true
        buttons[name].BackgroundTransparency = 0
    end
end)
