-- SOUND
local yaySound = nil
local function resolveSoundId()
    if YAY_SOUND_ID ~= "" then
        return YAY_SOUND_ID
    end
    if isfile and getcustomasset then
        local okFile, exists = pcall(isfile, YAY_FILE)
        if okFile and exists then
            local okAsset, asset = pcall(getcustomasset, YAY_FILE)
            if okAsset then
                return asset
            end
        end
    end
    return nil
end

local function playYay()
    local id = resolveSoundId()
    if not id then
        return
    end
    if not yaySound then
        yaySound = make("Sound", { Name = "T1ST_Yay", Volume = 1 }, SoundService)
    end
    yaySound.SoundId = id
    yaySound.TimePosition = 0
    yaySound:Play()
end

-- ROLL LOGIC
local function lockSlot(i, result)
    local slot = slots[i]
    slot.fill.BackgroundColor3 = result.color
    slot.name.Text = string.upper(result.name)
    slot.name.TextColor3 = THEME.text
    slot.stroke.Color = Color3.new(1, 1, 1)
    TweenService:Create(slot.stroke, TweenInfo.new(0.4), { Color = THEME.line }):Play()
end

local function describe(results)
    local counts, order = {}, {}
    for _, r in ipairs(results) do
        if not counts[r.name] then
            counts[r.name] = 0
            table.insert(order, r.name)
        end
        counts[r.name] += 1
    end
    local parts = {}
    for _, name in ipairs(order) do
        table.insert(parts, counts[name] .. " " .. string.upper(name))
    end
    return table.concat(parts, "  /  ")
end

local function roll()
    if rolling then
        return
    end

    local pool = {}
    for _, p in ipairs(palette) do
        if enabled[p.name] then
            table.insert(pool, p)
        end
    end

    if #pool == 0 then
        summary.Text = "SELECT AT LEAST ONE COLOR"
        summary.TextColor3 = Color3.fromRGB(255, 120, 120)
        task.delay(1.2, function()
            if alive and not rolling then
                summary.Text = "READY"
                summary.TextColor3 = THEME.muted
            end
        end)
        return
    end

    rolling = true
    rollBtn.Text = "ROLLING"
    rollBtn.BackgroundColor3 = THEME.inset
    rollBtn.TextColor3 = THEME.muted
    summary.Text = "..."
    summary.TextColor3 = THEME.muted

    local results = {}
    for i = 1, 4 do
        results[i] = pool[math.random(#pool)]
    end

    local lockAt = { 0.7, 1.05, 1.4, 1.75 }
    local locked = { false, false, false, false }
    local started = os.clock()

    while alive do
        local t = os.clock() - started
        local done = true
        for i = 1, 4 do
            if not locked[i] then
                if t >= lockAt[i] then
                    locked[i] = true
                    lockSlot(i, results[i])
                else
                    done = false
                    local flick = pool[math.random(#pool)]
                    slots[i].fill.BackgroundColor3 = flick.color
                    slots[i].name.Text = "..."
                    slots[i].name.TextColor3 = THEME.muted
                end
            end
        end
        if done then
            break
        end
        task.wait(0.05)
    end

    if not alive then
        return
    end

    rollCount += 1
    table.insert(history, 1, { id = rollCount, results = results })
    if #history > 3 then
        table.remove(history)
    end
    renderHistory()

    summary.Text = describe(results)
    summary.TextColor3 = THEME.text
    playYay()

    rolling = false
    rollBtn.Text = "ROLL"
    rollBtn.BackgroundColor3 = THEME.accent
    rollBtn.TextColor3 = Color3.new(1, 1, 1)
end

