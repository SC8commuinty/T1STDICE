-- RAIN BACKGROUND
local rainLayer = Instance.new("Frame")
rainLayer.Size = UDim2.fromScale(1,1)
rainLayer.BackgroundTransparency = 1
rainLayer.ClipsDescendants = true
rainLayer.Parent = gui

local rainDrops = {}

for i = 1,65 do
    local drop = Instance.new("Frame")
    drop.Size = UDim2.fromOffset(1,math.random(8,18))
    drop.Position = UDim2.fromScale(
        math.random(),
        math.random()
    )
    drop.BackgroundColor3 = Color3.fromRGB(120,160,190)
    drop.BackgroundTransparency = 0.45
    drop.BorderSizePixel = 0
    drop.Parent = rainLayer

    table.insert(rainDrops,{
        object = drop,
        speed = math.random(50,110)
    })
end

local rainConnection = RunService.RenderStepped:Connect(function(dt)
    for _,data in ipairs(rainDrops) do
        local drop = data.object
        local pos = drop.Position

        drop.Position = UDim2.new(
            pos.X.Scale,
            pos.X.Offset,
            pos.Y.Scale,
            pos.Y.Offset + data.speed * dt
        )

        if drop.Position.Y.Offset > 900 then
            drop.Position = UDim2.new(
                math.random(),
                0,
                0,
                -20
            )
        end
    end
end)

